<Page x:Class="OOD_Project.Create_Bird"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="Create_Bird" Height="450" Width="800" Background="#66BB6A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="155*"/>
            <RowDefinition Height="85*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="101*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="85*"/>
            <ColumnDefinition Width="81*"/>
            <ColumnDefinition Width="469*"/>
            <ColumnDefinition Width="166*"/>
        </Grid.ColumnDefinitions>
        <TextBox Name="tbxCommonname" Text="Common Name"  Grid.Column="2" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="1" Margin="0,10,0,0" TextChanged="tbxCommonname_TextChanged"/>
        <TextBox Name="tbxScientificName" Text="Scientific name" TextAlignment="Center" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="1" Margin="0,50,0,0" TextChanged="tbxScientificName_TextChanged"/>
        <TextBox Name="tbxwhere" Grid.Column="2" Text="Where" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="2" Margin="0,10,0,0" TextChanged="tbxwhere_TextChanged"/>
        <Button Name="btnimg" Grid.Column="2" Content="Upload Image" HorizontalAlignment="Center" Height="28" Margin="0,117,0,0" VerticalAlignment="Top" Width="308" Click="btnimg_Click"/>
        <TextBox Name="tbxwhen" Grid.Column="2" Text="When" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="2" Margin="0,47,0,0" TextChanged="tbxwhen_TextChanged"/>
        <TextBox Name="tbxhowmany" Text="How many" TextAlignment="Center" Grid.Column="2" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="2" Margin="0,93,0,0" Grid.RowSpan="2" TextChanged="tbxhowmany_TextChanged"/>
        <Button Name="btncreatebird" Grid.Column="2" Content="Create!" HorizontalAlignment="Center" Height="24" VerticalAlignment="Center" Width="176" Grid.Row="3" Click="btncreatebird_Click"/>
        <Button Name="btnback" Content="Go Back" HorizontalAlignment="Left" Margin="31,0,0,0" Grid.Row="3" VerticalAlignment="Center" Height="24" Grid.Column="1" Click="btnback_Click"/>
        <Image Margin="157,2,157,44" Source="/Images/berd.png" Stretch="Fill" Grid.Column="2"/>
        <Frame Name="Create_Pg" NavigationUIVisibility="Hidden" />

    </Grid>
</Page>
