<Window x:Class="OOD_Project.Create_Bird"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="Create_Bird" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="155*"/>
            <RowDefinition Height="85*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="101*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="167*"/>
            <ColumnDefinition Width="473*"/>
            <ColumnDefinition Width="167*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="1" Margin="10,0,10,44" Source="/f0799ce52f1c4695ebf1910bdf4cd2f2.jpg" Stretch="Fill"/>
        <TextBox Name="tbxCommonname" Text="Common Name"  Grid.Column="1" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="1" Margin="0,10,0,0"/>
        <TextBox Name="tbxScientificName" Text="Scientific name" TextAlignment="Center" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="1" Margin="0,50,0,0"/>
        <TextBox Name="tbxwhere" Grid.Column="1" Text="Where" TextAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="2" Margin="0,10,0,0"/>
        <Button Name="btnimg" Grid.Column="1" Content="Upload Image" HorizontalAlignment="Center" Height="28" Margin="0,117,0,0" VerticalAlignment="Top" Width="308"/>
        <TextBox Name="tbxwhen" Grid.Column="1" Text="When" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="2" Margin="0,47,0,0"/>
        <TextBox Name="tbxhowmany" Text="How many" TextAlignment="Center" Grid.Column="1" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="2" Margin="0,93,0,0" Grid.RowSpan="2"/>
        <Button Name="btncreatebird" Grid.Column="1" Content="Create!" HorizontalAlignment="Center" Height="24" VerticalAlignment="Center" Width="177" Grid.Row="3"/>

    </Grid>
</Window>
