<Window x:Class="OOD_Project.Create_Bird"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="Create_Bird" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="155*"/>
            <RowDefinition Height="85*"/>
            <RowDefinition Height="93*"/>
            <RowDefinition Height="101*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="167*"/>
            <ColumnDefinition Width="473*"/>
            <ColumnDefinition Width="167*"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Column="1" Margin="10,0,10,44" Source="/f0799ce52f1c4695ebf1910bdf4cd2f2.jpg" Stretch="Fill"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,6,0,0" Grid.Row="2" TextWrapping="Wrap" Text="                 Password" VerticalAlignment="Top" Width="304" FontFamily="Copperplate Gothic Bold" FontWeight="Bold" FontSize="23" Height="27"/>
        <PasswordBox x:Name="tbxpasswd" Grid.Column="1" HorizontalAlignment="Center" Margin="0,47,0,0" Grid.Row="2" VerticalAlignment="Top" Width="304" Height="26"/>
        <TextBox x:Name="tbxuserinput" Grid.Column="1" HorizontalAlignment="Center" Margin="0,61,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="1"/>
        <TextBlock x:Name="tbxuser_Copy" Grid.Column="1" HorizontalAlignment="Left" Margin="84,2,0,0" TextWrapping="Wrap" Text="                Username" VerticalAlignment="Top" Width="304" FontFamily="Copperplate Gothic Bold" FontWeight="Bold" FontSize="23" Height="30" Grid.Row="3"/>
        <TextBox x:Name="tbxuserinput_Copy" Grid.Column="1" HorizontalAlignment="Left" Margin="82,51,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="308" Height="24" Grid.Row="3"/>

    </Grid>
</Window>
