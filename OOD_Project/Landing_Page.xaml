<Page x:Class="OOD_Project.Landing_Page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="Landing_Page" Height="450" Width="800" Loaded="Page_Loaded">
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="257*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="103*"/>
            <ColumnDefinition Width="103*"/>
        </Grid.ColumnDefinitions>
        <RadioButton Name="rdAPI" Grid.Column="1" Content="Database" HorizontalAlignment="Left" Margin="63,31,0,0" VerticalAlignment="Top" Checked="rdAPI_Checked"/>
        <ListBox Name="lbshowbird" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,51,10,0" SelectionChanged="lbshowbird_SelectionChanged"/>
        <TextBox Name="tbdescribebird" HorizontalAlignment="Center" Height="197" Grid.Row="1" TextWrapping="Wrap"  VerticalAlignment="Center" Width="380"/>
        <RadioButton Name="rdUserMade" Grid.Column="1" Content="UserCreated" HorizontalAlignment="Left" Margin="132,31,0,0" VerticalAlignment="Top" Checked="rdUserMade_Checked"/>
        <RadioButton Name="rdAll" Grid.Column="1" Content="All" HorizontalAlignment="Left" Margin="15,31,0,0" VerticalAlignment="Top" Checked="rdAll_Checked"/>
        <Button Name="btndelbird" Grid.Column="1" Content="Delete an entry" HorizontalAlignment="Left" Margin="149,194,0,0" Grid.Row="1" VerticalAlignment="Top" Height="24" Click="btndelbird_Click"/>
        <Frame Name="Landing_Pg" NavigationUIVisibility="Hidden" />
        <Button Name="btncreatebird" Grid.Column="1" Content="Create a Bird!" HorizontalAlignment="Left" Margin="315,194,0,0" Grid.Row="1" VerticalAlignment="Top" Height="24" Click="btncreatebird_Click"/>
        <Image Margin="10,10,10,10" Source="/boris-smokrovic-DPXytK8Z59Y-unsplash.jpg" Stretch="Fill"/>
        <Grid.Background>
            <ImageBrush ImageSource="/tienko-dima-uYoVf9I6ANI-unsplash.jpg"></ImageBrush>
        </Grid.Background>
        
    </Grid>
</Page>
