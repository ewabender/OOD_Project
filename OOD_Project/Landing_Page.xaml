<Page x:Class="OOD_Project.Landing_Page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="Landing_Page" Height="450" Width="800" Loaded="Page_Loaded"
      Background="#66BB6A">
    <Grid Margin="0,0,0,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="257*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="53*"/>
            <ColumnDefinition Width="47*"/>
            <ColumnDefinition Width="100*"/>
        </Grid.ColumnDefinitions>
        <RadioButton Name="rdAPI" Grid.Column="2" Content="Database" HorizontalAlignment="Left" Margin="63,31,0,0" VerticalAlignment="Top" Checked="rdAPI_Checked" Height="15" Width="68"/>
        <ListBox Name="lbshowbird" Grid.Column="2" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,51,10,0" SelectionChanged="lbshowbird_SelectionChanged"/>
        <TextBox Name="tbdescribebird" HorizontalAlignment="Center" Height="196" Grid.Row="1" TextWrapping="Wrap"  VerticalAlignment="Center" Width="380" Grid.ColumnSpan="2"/>
        <RadioButton Name="rdUserMade" Grid.Column="2" Content="UserCreated" HorizontalAlignment="Left" Margin="132,31,0,0" VerticalAlignment="Top" Checked="rdUserMade_Checked" Height="15" Width="84"/>
        <RadioButton Name="rdAll" Grid.Column="2" Content="All" HorizontalAlignment="Left" Margin="15,31,0,0" VerticalAlignment="Top" Checked="rdAll_Checked" Height="15" Width="33"/>
        <Button Name="btndelbird" Grid.Column="2" Content="Delete an entry" HorizontalAlignment="Left" Margin="149,194,0,0" Grid.Row="1" VerticalAlignment="Top" Height="24" Click="btndelbird_Click" Width="85"/>
        <Frame Name="Landing_Pg" NavigationUIVisibility="Hidden" Grid.ColumnSpan="2" />
        <Button Name="btncreatebird" Grid.Column="2" Content="Create a Bird!" HorizontalAlignment="Left" Margin="315,194,0,0" Grid.Row="1" VerticalAlignment="Top" Height="24" Click="btncreatebird_Click" Width="75"/>
        <!--<Image Margin="10,10,10,10" Source="/Images/boris-smokrovic-DPXytK8Z59Y-unsplash.jpg" Stretch="Fill" Grid.ColumnSpan="2"/>-->
        <Image Margin="10,10,10,10" Source="I" Stretch="Fill" Grid.ColumnSpan="2"/>


    </Grid>
</Page>
