<Window x:Class="OOD_Project.Landing_Page"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="Landing_Page" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="257*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="103*"/>
            <ColumnDefinition Width="103*"/>
        </Grid.ColumnDefinitions>
        <Image Margin="10,10,10,10" Source="/gru-despicable-me.png" Stretch="Fill"/>
        <RadioButton Name="rdEurope" Grid.Column="1" Content="Europe" HorizontalAlignment="Left" Margin="63,31,0,0" VerticalAlignment="Top"/>
        <ListBox Name="lbshowbird" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,51,10,10" Grid.RowSpan="2"/>
        <TextBox Name="tbdescribebird" HorizontalAlignment="Center" Height="197" Grid.Row="1" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" Width="380" TextChanged="TextBox_TextChanged"/>
        <RadioButton Name="rdAmericas" Grid.Column="1" Content="Americas" HorizontalAlignment="Left" Margin="132,31,0,0" VerticalAlignment="Top"/>
        <RadioButton Name="rdOceania"  Grid.Column="1" Content="Oceania" HorizontalAlignment="Left" Margin="213,31,0,0" VerticalAlignment="Top"/>
        <RadioButton Name="rdAsia" Grid.Column="1" Content="Asia" HorizontalAlignment="Left" Margin="287,31,0,0" VerticalAlignment="Top"/>
        <RadioButton Name="rdAfrica" Grid.Column="1" Content="Africa" HorizontalAlignment="Left" Margin="341,31,0,0" VerticalAlignment="Top"/>
        <RadioButton Name="rdAll" Grid.Column="1" Content="All" HorizontalAlignment="Left" Margin="15,31,0,0" VerticalAlignment="Top"/>

    </Grid>
</Window>
