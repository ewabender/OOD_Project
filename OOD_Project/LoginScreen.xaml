<Page x:Class="OOD_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="LoginScreen" Height="450" Width="800" Background="#66BB6A">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="124*"/>
            <RowDefinition Height="173*"/>
            <RowDefinition Height="137*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205*"/>
            <ColumnDefinition Width="412*"/>
            <ColumnDefinition Width="205*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="tbxuser" Grid.Column="1" HorizontalAlignment="Left" Margin="53,13,0,0" TextWrapping="Wrap" Text="                Username" VerticalAlignment="Top" Width="303" FontFamily="Copperplate Gothic Bold" FontWeight="Bold" FontSize="23" Height="49" Grid.Row="1"/>
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" Margin="0,96,0,0" Grid.Row="1" TextWrapping="Wrap" Text="                 Password" VerticalAlignment="Top" Width="303" FontFamily="Copperplate Gothic Bold" FontWeight="Bold" FontSize="23" Height="49"/>
        <Button Name="btnlogin" Grid.Column="1" Content="Login" HorizontalAlignment="Left" Margin="49,0,0,0" Grid.Row="2" VerticalAlignment="Center" Width="307" Height="24" Click="btnlogin_Click" Cursor="Hand" />

        <PasswordBox x:Name="tbxpasswd" Grid.Column="1" HorizontalAlignment="Left" Margin="53,140,0,0" Grid.Row="1" VerticalAlignment="Top" Width="303" Height="24"/>
        <TextBox x:Name="tbxuserinput" Grid.Column="1" HorizontalAlignment="Left" Margin="51,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="307" Height="24" Grid.Row="1" TextChanged="tbxuserinput_TextChanged"/>
        <Image Margin="140,0,107,4" Source="/Images/berd.png" Stretch="Fill" Grid.Column="1" />
    </Grid>
</Page>
