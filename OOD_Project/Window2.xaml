<Window x:Class="OOD_Project.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OOD_Project"
        mc:Ignorable="d"
        Title="Window2" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="257*"/>
            <RowDefinition Height="257*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="103*"/>
            <ColumnDefinition Width="103*"/>
        </Grid.ColumnDefinitions>
        <Image Margin="10,10,10,10" Source="/gru-despicable-me.png" Stretch="Fill"/>
        <RadioButton Name="rdEurope" Grid.Column="1" Content="Europe" HorizontalAlignment="Left" Margin="63,31,0,0" VerticalAlignment="Top"/>
        <ListBox Name="lbshowbird" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,51,10,0"/>
        <TextBox Name="tbdescribebird" HorizontalAlignment="Center" Height="197" Grid.Row="1" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Center" Width="380" />
        <RadioButton Name="rdAmericas" Grid.Column="1" Content="Americas" HorizontalAlignment="Left" Margin="132,31,0,0" VerticalAlignment="Top"/>
        <RadioButton Name="rdOceania"  Grid.Column="1" Content="Oceania" HorizontalAlignment="Left" Margin="213,31,0,0" VerticalAlignment="Top"/>
        <RadioButton Name="rdAsia" Grid.Column="1" Content="Asia" HorizontalAlignment="Left" Margin="287,31,0,0" VerticalAlignment="Top"/>
        <RadioButton Name="rdAfrica" Grid.Column="1" Content="Africa" HorizontalAlignment="Left" Margin="341,31,0,0" VerticalAlignment="Top"/>
        <RadioButton Name="rdAll" Grid.Column="1" Content="All" HorizontalAlignment="Left" Margin="15,31,0,0" VerticalAlignment="Top"/>
        <ListBox Name="lbxuserbirds" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="10,10,10,41" Grid.Row="1"/>
        <Button Name="btndelbird" Grid.Column="1" Content="Delete an entry" HorizontalAlignment="Left" Margin="149,194,0,0" Grid.Row="1" VerticalAlignment="Top" Height="24"/>
        <Button Name="btncreatebird" Grid.Column="1" Content="Create a Bird!" HorizontalAlignment="Left" Margin="315,194,0,0" Grid.Row="1" VerticalAlignment="Top" Height="24" Click="btncreatebird_Click" />

    </Grid>
</Window>
