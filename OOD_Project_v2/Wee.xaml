<Page x:Class="OOD_Project_v2.Wee"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OOD_Project_v2"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Wee">
    

    <Grid>
        <Border CornerRadius="10" Background="#E8F5E9"></Border>
        <Button Content="Page 1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="40" Width="348" Click="Button_Click"/>
        <RadioButton Name="rdbchicken" Content="Chicken Jockey" HorizontalAlignment="Left" Margin="103,75,0,0" VerticalAlignment="Top" Checked="rdbchicken_Checked"/>
        <RadioButton Name="rdbrex" Content="T rex" HorizontalAlignment="Left" Margin="244,75,0,0" VerticalAlignment="Top" Checked="rdbrex_Checked"/>
        <ListBox Name="lbxcarrot" HorizontalAlignment="Center" Height="162" Margin="0,264,0,0" VerticalAlignment="Top" Width="494" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <Frame x:Name="_Nav1" NavigationUIVisibility="Hidden" Margin="-10,-10,10,10" Navigated="_Nav1_Navigated" Initialized="_Nav1_Initialized" />
        <RadioButton Name="rbtRee" Content="Ree" HorizontalAlignment="Left" Margin="348,75,0,0" VerticalAlignment="Top" Checked="rbtRee_Checked"/>

    </Grid>
    
</Page>
